<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full run. Creates bookings, so it needs BOOKER_USERNAME and BOOKER_PASSWORD.
-->
<suite name="regression" verbose="0" parallel="false">
  <listeners>
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
  </listeners>
  <test name="offline">
    <classes>
      <class name="com.adarsh.tests.config.ConfigPrecedenceTest"/>
      <class name="com.adarsh.tests.models.BookingModelTest"/>
    </classes>
  </test>
  <test name="health">
    <classes>
      <class name="com.adarsh.tests.health.PingTest"/>
    </classes>
  </test>
  <test name="auth">
    <classes>
      <class name="com.adarsh.tests.auth.AuthTest"/>
    </classes>
  </test>
</suite>
